{
  "packageManager": "pnpm@9.4.0",
  "version": "3.2.1",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "dts watch",
    "build": "dts build",
    "prepare": "pnpm run build",
    "test": "dts test",
    "test:coverage": "dts test --coverage",
    "lint": "dts lint",
    "lint-fix": "dts lint --fix",
    "size": "size-limit",
    "gen:contract": "rm -rf src/generated/smartContract/* && tsx ./scripts/gen-contract.ts && prettier --write 'src/generated/smartContract'",
    "docs": "typedoc src/index.ts",
    "docs:watch": "typedoc src/index.ts --watch",
    "analyze": "size-limit --why",
    "ci": "pnpm run lint && pnpm run test && pnpm run size"
  },
  "husky": {
    "hooks": {
      "pre-commit": "dts lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "name": "alex-sdk",
  "author": "Kyle Fang",
  "module": "dist/alex-sdk.esm.js",
  "size-limit": [
    {
      "path": "dist/alex-sdk.cjs.production.min.js",
      "limit": "20 KB"
    },
    {
      "path": "dist/alex-sdk.esm.js",
      "limit": "20 KB"
    }
  ],
  "dependencies": {
    "clarity-codegen": "1.0.0-beta.1"
  },
  "peerDependencies": {
    "@stacks/network": "^7.0.2",
    "@stacks/transactions": "^7.0.2"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^8.2.4",
    "@stacks/network": "^7.0.2",
    "@stacks/stacks-blockchain-api-types": "^7.11.0",
    "@stacks/transactions": "^7.0.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "ajv": "^8.16.0",
    "dts-cli": "^2.0.5",
    "esm": "^3.2.25",
    "fetch-mock": "^10.0.7",
    "husky": "^8.0.3",
    "prettier": "^2.8.4",
    "size-limit": "^8.2.4",
    "ts-json-schema-generator": "^2.3.0",
    "tslib": "^2.6.3",
    "tsx": "^4.15.5",
    "typedoc": "^0.26.6",
    "typescript": "^5.4.5"
  }
}
